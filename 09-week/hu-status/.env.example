# Example .env for OptiView's Corte 1 backend (optiview-platform), written for Week 9's
# activity on configuration/secrets. Real file would be gitignored and never committed;
# this copy documents the required variables as this week's hands-on exercise.
#
# Source of the mistake this fixes: backend/src/main/resources/application.yml and
# docker-compose.yml currently hard-code fallback values for these same variables
# (clave-de-desarrollo-optiview-cambiar-min-32-bytes, optiview) instead of requiring
# them — exactly the "secrets in git" / "silent startup with missing config" mistakes
# from this week's session 1 material.

# --- Database (PostgreSQL) ---------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/optiview
SPRING_DATASOURCE_USERNAME=optiview
# Generate a real value for anything beyond local dev — do not reuse this placeholder.
SPRING_DATASOURCE_PASSWORD=optiview

# --- JWT signing (app.jwt.secret in application.yml) -------------------------
# Generate with: openssl rand -base64 32
# Minimum 32 bytes per application.yml's own comment. Rotate if ever exposed.
APP_JWT_SECRET=change-me-generate-a-real-32-byte-secret

# --- CORS ---------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
